{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/leeclarkuk/platform-engineering-reference/api/v1alpha1/workloadcontract.schema.json",
  "title": "WorkloadContract",
  "description": "Platform contract for a golden-path workload. ServiceAccount name and namespace are contract strings (ADR-0002), not a live Kubernetes object. AWS identifiers, IAM, VPC, cluster, Terraform, and GitOps apply fields are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "platform.engineering.reference/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "WorkloadContract"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "RFC 1123 DNS label"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "goldenPath", "serviceAccount"],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "goldenPath": {
          "type": "string",
          "const": "helm"
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "name"],
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "description": "RFC 1123 DNS label (ADR-0002 contract string)"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "description": "RFC 1123 DNS label (ADR-0002 contract string)"
            }
          }
        }
      }
    }
  }
}
